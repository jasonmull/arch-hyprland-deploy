{
  "archinstall-language": "English",
  "bootloader": "Systemd-boot",
  "hostname": "archbox",
  "kernels": [
    "linux"
  ],
  "ntp": true,
  "swap": true,
  "timezone": "America/Chicago",
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "network_config": {
    "type": "nm"
  },
  "audio_config": {
    "audio": "pipewire"
  },
  "profile_config": null,
  "packages": [
    "base-devel",
    "git",
    "sudo",
    "vim",
    "openssh"
  ],
  "additional-repositories": [],
  "parallel downloads": 5,
  "disk_config": {
    "config_type": "manual_partitioning",
    "device_modifications": [
      {
        "device": "/dev/nvme0n1",
        "wipe": true,
        "partitions": [
          {
            "obj_id": "esp-0",
            "status": "create",
            "type": "primary",
            "flags": [
              "boot",
              "esp"
            ],
            "fs_type": "fat32",
            "mountpoint": "/boot",
            "mount_options": [],
            "start": {
              "unit": "MiB",
              "value": 1
            },
            "size": {
              "unit": "GiB",
              "value": 1
            },
            "btrfs": []
          },
          {
            "obj_id": "root-0",
            "status": "create",
            "type": "primary",
            "flags": [],
            "fs_type": "ext4",
            "mountpoint": "/",
            "mount_options": [],
            "start": {
              "unit": "GiB",
              "value": 1
            },
            "size": {
              "unit": "Percent",
              "value": 100
            },
            "btrfs": []
          }
        ]
      }
    ]
  }
}
