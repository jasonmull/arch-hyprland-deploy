# Ghostty configuration - stowed to ~/.config/ghostty/config
#
# Keybind scheme note: SUPER is reserved for Hyprland (see hyprland.conf), so
# every binding here uses CTRL+SHIFT. That way nothing in the terminal ever
# shadows a window-manager binding.

# --- Font --------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = -calt
adjust-cell-height = 10%

# --- Appearance --------------------------------------------------------------
theme = catppuccin-mocha
background-opacity = 0.92
background-blur = true
window-padding-x = 10
window-padding-y = 8
window-decoration = none
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
scrollback-limit = 100000

# --- Behaviour ---------------------------------------------------------------
confirm-close-surface = false
window-save-state = never
copy-on-select = clipboard
shell-integration = detect
shell-integration-features = cursor,sudo,title

# --- Keybinds ----------------------------------------------------------------
# Clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab

# Splits - mirrors the Hyprland directional model
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down

# Font size
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Misc
keybind = ctrl+shift+r=reload_config
