# mako notification daemon - stowed to ~/.config/mako/config
# Reload after edits with: makoctl reload

font=JetBrainsMono Nerd Font 10
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

width=380
height=140
margin=10
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=6000
ignore-timeout=1
layer=overlay
anchor=top-right

[urgency=low]
border-color=#45475a
default-timeout=4000

[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

[app-name=volume]
default-timeout=1500
